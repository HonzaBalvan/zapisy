Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"n", "+", "1"}], "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "3"}], "*", 
        RowBox[{"a", "[", "n", "]"}]}], "+", "1"}]}], ",", 
     RowBox[{
      RowBox[{"a", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"a", "[", "n", "]"}], ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.992673230245872*^9, 3.9926732850155497`*^9}, {
  3.9926735099078197`*^9, 3.992673512680007*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"dbb8380c-92a9-4da2-bf38-fcaee89b1c37"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox["3", 
      RowBox[{"1", "-", "n"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["3", "n"]}], ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.992673513710134*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"c5f9fb1f-68b1-4277-ba6b-c1d604f946a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"a", "=", "6378"}], "\[IndentingNewLine]", 
 RowBox[{"b", "=", "6358"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
