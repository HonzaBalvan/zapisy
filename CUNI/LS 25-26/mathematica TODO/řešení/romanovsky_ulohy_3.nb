Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"(", "1", ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"16", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "+", 
             RowBox[{"I", "*", "y"}]}], ")"}], "^", "2"}]}], ")"}]}]}], ")"}],
      "^", "3"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1.5"}], ",", " ", "1.5"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"y", ",", " ", 
     RowBox[{"-", "1.5"}], ",", " ", "1.5"}], "}"}], ",", " ", 
   RowBox[{"PlotPoints", "->", "100"}], ",", " ", 
   RowBox[{"Contours", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"1", "/", "2"}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], ",", "1", ",", 
      RowBox[{"-", "1"}], ",", "2", ",", 
      RowBox[{"-", "2"}], ",", "5", ",", 
      RowBox[{"-", "5"}]}], "}"}]}]}], "]"}]], "Input",
