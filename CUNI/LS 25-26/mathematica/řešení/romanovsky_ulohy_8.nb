   RowBox[{
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{
       RowBox[{"zetka", "[", 
        RowBox[{"z", ",", "n"}], "]"}], ",", 
       RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], "&"}], ",", 
    RowBox[{"acka", "[", "n", "]"}]}], "]"}]}]], "Input",
