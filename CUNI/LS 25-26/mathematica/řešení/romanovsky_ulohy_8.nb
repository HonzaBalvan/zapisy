Cell[BoxData[{
 RowBox[{
  RowBox[{"acka", "[", "n_", "]"}], ":=", 
  RowBox[{"IntegerDigits", "[", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"2", "^", "n"}], "-", "1"}]}], "]"}], ",", "2", ",", "n"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zetka", "[", 
   RowBox[{"z_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"z", "^", "i"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9963779049919777`*^9, 3.996377918414431*^9}, {
  3.996377966201151*^9, 3.9963779963716183`*^9}, {3.996378031569055*^9, 
