Cell[BoxData[
 RowBox[{"NDSolveValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"10", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "-", 
         RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"28", 
        RowBox[{"x", "[", "t", "]"}]}], "-", 
       RowBox[{"y", "[", "t", "]"}], "-", 
       RowBox[{
        RowBox[{"z", "[", "t", "]"}], "*", 
        RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "8"}], "/", "3"}], 
        RowBox[{"z", "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], "*", 
        RowBox[{"y", "[", "t", "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], "==", "5"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "5"}], ",", 
     RowBox[{
      RowBox[{"z", "[", "0", "]"}], "==", "5"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "t", "]"}], ",", 
     RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9960326598604336`*^9, 3.996032669167715*^9}, {
  3.996032735135914*^9, 3.996032746917761*^9}, {3.996032805155653*^9, 
