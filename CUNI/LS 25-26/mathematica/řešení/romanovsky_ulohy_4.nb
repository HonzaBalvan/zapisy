Cell[BoxData[{
 RowBox[{
  RowBox[{"latinskyCtverec", "[", 
   RowBox[{"p_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", "i"}], "+", "j"}], ",", "p"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"p", "-", "1"}]}], "}"}], ",", " ", 
