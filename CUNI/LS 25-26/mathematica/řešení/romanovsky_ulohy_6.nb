  RowBox[{"seznamVektoru", "[", "n_", "]"}], ":=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"randomCisla", "[", "n", "]"}], "}"}], ",", 
