Cell[BoxData[
 RowBox[{"DiscreteLimit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Pi", "^", 
      RowBox[{"(", 
       RowBox[{"n", "/", "2"}], ")"}]}], ")"}], "/", 
