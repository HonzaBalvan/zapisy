Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"randomWalk", ",", "randomCisla"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randomCisla", "[", "n_", " ", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"RandomReal", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], ",", "n"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randomWalk", "[", 
   RowBox[{"n_", ",", " ", "seznamRandom_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
