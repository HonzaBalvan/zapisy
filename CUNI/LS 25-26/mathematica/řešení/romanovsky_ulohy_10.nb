Cell[BoxData[{
 RowBox[{"Clear", "[", "dirichletPosl", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dirichletPosl", "[", 
   RowBox[{"a_", ",", "d_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"prvocisla", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"n", "=", "0"}], ",", "num"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "prvocisla", "]"}], "<", "k"}], ",", 
       RowBox[{
        RowBox[{"num", "=", 
         RowBox[{"a", "+", 
          RowBox[{"n", "*", "d"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PrimeQ", "[", "num", "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"prvocisla", ",", "num"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "prvocisla"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.996472926152981*^9, 3.996473067881405*^9}, {
