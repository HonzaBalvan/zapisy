Cell[BoxData[
 RowBox[{
  RowBox[{"turtle", "[", 
   RowBox[{"s_String", ",", "angle_", ",", "startdir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", "=", "startdir"}], ",", 
      RowBox[{"pos", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"path", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "}"}]}], ",", "left", ",", "right", ",",
       "i", ",", 
      RowBox[{"ch", "=", 
       RowBox[{"Characters", "[", "s", "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"left", "=", 
      RowBox[{"RotationMatrix", "[", "angle", "]"}]}], ";", 
     RowBox[{"right", "=", 
      RowBox[{"RotationMatrix", "[", 
       RowBox[{"-", "angle"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<+\>\""}], ",", 
         RowBox[{"dir", "=", 
          RowBox[{"left", ".", "dir"}]}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<-\>\""}], ",", 
         RowBox[{"dir", "=", 
          RowBox[{"right", ".", "dir"}]}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<F\>\""}], ",", 
         RowBox[{
          RowBox[{"pos", "+=", "dir"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"path", ",", "pos"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "ch", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"path", ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.996554740330152*^9, 3.9965547403301888`*^9}, {
   3.996554789680747*^9, 3.996554793981555*^9}, 3.99655492353932*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"11edd858-fd02-472e-afe9-1a19e39911da"],

