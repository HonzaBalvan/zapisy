Cell[BoxData[
 RowBox[{
  RowBox[{"caesar", "[", 
   RowBox[{"str_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"StringReplace", "[", 
   RowBox[{"str", ",", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "->", "#2"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Alphabet", "[", "]"}], ",", 
        RowBox[{"RotateLeft", "[", 
         RowBox[{
          RowBox[{"Alphabet", "[", "]"}], ",", "n"}], "]"}]}], "}"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9964794711086617`*^9, 3.9964796049446373`*^9}, {
  3.996479645900544*^9, 3.996479682561077*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"fcc14c96-9baf-49ab-8ca2-e50a692dda80"],

