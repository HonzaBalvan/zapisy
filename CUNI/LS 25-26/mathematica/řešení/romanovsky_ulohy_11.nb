  3.99655758078997*^9}},ExpressionUUID->"266af871-5d05-485b-bca5-\
34ead62ac7dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"turtleNova", "[", 
   RowBox[{"s_String", ",", "angle_", ",", "startdir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", "=", "startdir"}], ",", 
      RowBox[{"pos", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"path", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "}"}]}], ",", "left", ",", "right", ",",
       "i", ",", 
      RowBox[{"ch", "=", 
       RowBox[{"Characters", "[", "s", "]"}]}], ",", 
      RowBox[{"zasobnik", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"left", "=", 
      RowBox[{"RotationMatrix", "[", "angle", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"right", "=", 
      RowBox[{"RotationMatrix", "[", 
       RowBox[{"-", "angle"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<+\>\""}], ",", 
         RowBox[{"dir", "=", 
          RowBox[{"left", ".", "dir"}]}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<-\>\""}], ",", 
         RowBox[{"dir", "=", 
          RowBox[{"right", ".", "dir"}]}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<F\>\""}], ",", 
         RowBox[{
          RowBox[{"pos", "+=", "dir"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"path", ",", "pos"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<[\>\""}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"zasobnik", ",", 
           RowBox[{"{", 
            RowBox[{"pos", ",", "dir"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"ch", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "\"\<]\>\""}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "zasobnik", "]"}], ">", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"pos", ",", "dir"}], "}"}], "=", 
             RowBox[{"zasobnik", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"zasobnik", "=", 
             RowBox[{"Most", "[", "zasobnik", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"path", ",", "pos"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "ch", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"path", ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.996555185429906*^9, 3.996555185880718*^9}, {
  3.996555229707046*^9, 3.996555239520103*^9}, {3.996555426178094*^9, 
